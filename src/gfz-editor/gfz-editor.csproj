    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>gfz_editor</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
